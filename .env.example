# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
CAPACITOR_SERVER_URL=

# AI providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PYME_PRICE_ID=
STRIPE_BASICO_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Upstash Redis (rate limiting -- opcional, fallback a in-memory si no se configura)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Alertas a Telegram (relay /api/alerts/telegram)
# BotFather -> token; chat_id via @userinfobot o getUpdates; secret: cadena larga aleatoria
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_ALERT_WEBHOOK_SECRET=

# Email (Resend via Supabase SMTP)
RESEND_API_KEY=
